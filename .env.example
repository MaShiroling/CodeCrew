CODECREW_ENVIRONMENT=development
CODECREW_DATABASE_URL=sqlite:///./codecrew.db
CODECREW_ARTIFACT_ROOT=.codecrew/artifacts
CODECREW_WORKTREE_ROOT=.codecrew/worktrees
# Optional repository-free chat roots; defaults are ~/.codecrew/chat-workspaces and chat-runtime.
# Keep both outside Git repositories and private to the current user.
# CODECREW_STANDALONE_CHAT_WORKSPACE_ROOT=/absolute/private/chat-workspaces
# CODECREW_STANDALONE_CHAT_RUNTIME_ROOT=/absolute/private/chat-runtime
CODECREW_MAX_REWORK_ROUNDS=2
CODECREW_AGENT_TIMEOUT_SECONDS=900
# Optional Planner-only deadline (1-900 seconds). Unset inherits the runner default.
# CODECREW_PLANNER_TIMEOUT_SECONDS=360
# Opt-in Claude CLI native Reviewer schema; one attempt, no text fallback.
CODECREW_REVIEWER_STRUCTURED_OUTPUT=false
CODECREW_CLAUDE_CLI_PATH=claude
CODECREW_CODEX_CLI_PATH=codex
CODECREW_KIMI_CLI_PATH=kimi
# Local lexical retrieval: legacy (default) or opt-in bm25. No cloud calls added.
# Keep legacy for the frozen control until the paired FTS evaluation is complete.
CODECREW_MEMORY_LEXICAL_BACKEND=legacy
# Opt-in Qdrant recall uses cached vectors and the versioned outbox namespace.
# Initialize/register/backfill/deliver explicitly first; chat does not do remote setup or sync.
CODECREW_MEMORY_VECTOR_STORE=sqlite
CODECREW_MEMORY_QDRANT_URL=http://127.0.0.1:6333
CODECREW_MEMORY_QDRANT_COLLECTION_PREFIX=codecrew_memory
CODECREW_MEMORY_QDRANT_API_KEY=
CODECREW_MEMORY_QDRANT_TIMEOUT_SECONDS=5
# Opt-in standalone worker: explicit app.chat.vector_sync --watch is ALSO required.
# Loading settings/chat-serve never starts delivery; no automatic target setup or cloud work.
CODECREW_MEMORY_VECTOR_WORKER_ENABLED=false
CODECREW_MEMORY_VECTOR_WORKER_BATCH_SIZE=32
CODECREW_MEMORY_VECTOR_WORKER_POLL_INTERVAL_SECONDS=2
CODECREW_MEMORY_VECTOR_WORKER_SHUTDOWN_GRACE_SECONDS=10
# For Kimi Code membership, export KIMI_MODEL_API_KEY in the launching shell; do not put it here.
CODECREW_AGENT_OUTPUT_QUEUE_MAXSIZE=256
CODECREW_PROCESS_TERMINATE_GRACE_SECONDS=2.0
CODECREW_MAX_CONVERSATION_AGENT_TURNS=30
CODECREW_MAX_CONVERSATION_TOKENS=500000
CODECREW_MAX_CONVERSATION_DURATION_SECONDS=7200
CODECREW_MAX_CONVERSATION_MESSAGES=200
CODECREW_MAX_REPEATED_MESSAGES=3
CODECREW_MAX_QUESTIONS_WITHOUT_PROGRESS=4

# Feishu is mounted ONLY by chat-serve --feishu, even when enabled is true.
CODECREW_FEISHU_ENABLED=false
CODECREW_FEISHU_APP_ID=
# Export the real secret in the launching shell; never commit credentials.
CODECREW_FEISHU_APP_SECRET=
# Missing bot ID disables group admission; allowlisted DMs still work.
CODECREW_FEISHU_BOT_OPEN_ID=
# JSON arrays, NOT comma-separated text. Both must be nonempty to start.
CODECREW_FEISHU_ALLOWED_CHAT_IDS=[]
CODECREW_FEISHU_ALLOWED_SENDER_OPEN_IDS=[]
CODECREW_FEISHU_MAX_OUTBOX_ATTEMPTS=5
CODECREW_FEISHU_RETRY_BASE_SECONDS=2
CODECREW_FEISHU_RETRY_CAP_SECONDS=60
