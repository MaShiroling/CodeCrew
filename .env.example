CODECREW_ENVIRONMENT=development
CODECREW_DATABASE_URL=sqlite:///./codecrew.db
CODECREW_ARTIFACT_ROOT=.codecrew/artifacts
CODECREW_WORKTREE_ROOT=.codecrew/worktrees
CODECREW_MAX_REWORK_ROUNDS=2
CODECREW_AGENT_TIMEOUT_SECONDS=900
CODECREW_CLAUDE_CLI_PATH=claude
CODECREW_CODEX_CLI_PATH=codex
CODECREW_KIMI_CLI_PATH=kimi
CODECREW_AGENT_OUTPUT_QUEUE_MAXSIZE=256
CODECREW_PROCESS_TERMINATE_GRACE_SECONDS=2.0
CODECREW_MAX_CONVERSATION_AGENT_TURNS=30
CODECREW_MAX_CONVERSATION_TOKENS=500000
CODECREW_MAX_CONVERSATION_DURATION_SECONDS=7200
CODECREW_MAX_CONVERSATION_MESSAGES=200
CODECREW_MAX_REPEATED_MESSAGES=3
CODECREW_MAX_QUESTIONS_WITHOUT_PROGRESS=4
